{
  "name": "scenara",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx src/lib/seed.ts",
    "db:reset": "prisma migrate reset --force && tsx src/lib/seed.ts",
    "worker:status": "curl -s -H 'x-worker-secret: dev-worker-secret' http://localhost:3000/api/worker",
    "test:auth": "tsx --test src/lib/auth.test.ts",
    "test:worker": "tsx --test src/lib/worker.test.ts",
    "test:unit": "tsx --test src/**/*.test.ts",
    "test:integration": "tsx --test tests/**/*.test.ts",
    "test:all": "tsx --test src/**/*.test.ts tests/**/*.test.ts",
    "test": "tsx --test src/**/*.test.ts tests/**/*.test.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "@prisma/client": "^6.4.0",
    "d3-force": "^3.0.0",
    "framer-motion": "^12.4.7",
    "jose": "^6.2.12",
    "lucide-react": "^1.16.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/d3-force": "^3.0.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^3.0.3",
    "cookie": "^2.0.2",
    "jsonwebtoken": "^9.0.3",
    "postcss": "^8.5.2",
    "prisma": "^6.4.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
